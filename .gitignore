# Never commit credential containers or installable distribution artifacts.
*.pk8
*.p7b
*.p12
*.pfx
*.pem
*.key
*.apk
*.aab

# Accidental literal ${user.home} tooling caches (Robolectric/Maven test downloads)
${user.home}/

# Verified local Rust Android artifacts (rebuilt from source)
.native/

# Governance audit raw logs (keep the SUMMARY .md reports, ignore transient logs)
reports/baseline/

# Local agent working notes
.workbuddy/

# Local investigation outputs (source snapshots, captures); too large and device-specific to commit
/artifacts/
