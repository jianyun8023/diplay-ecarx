# Copy this file to `.env` and fill in the local paths.
#
# `.env` is git-ignored; this example is the committed reference. Environment variables with
# the same names take precedence over `.env`. With neither present, builds stay identity-free
# and unsigned — that is what CI and public releases use.
#
# Usage: `cp .env.example .env`, then build the standalone package:
#   ./gradlew :mobile:assembleStandaloneDebug       # car-test debug (applicationId .hudtest)
#   ./gradlew :mobile:assembleStandaloneRelease     # release package, upgrades public releases

# MFi runtime identity. Expected layout: <dir>/offline-mfi/{identity.pk8,certificate.p7b}
# Only these two files are accepted; anything else in the assets tree fails
# :mobile:rejectBundledCredentials deliberately.
DIPLAY_AUTH_ASSETS_DIR=/absolute/path/to/runtime-assets

# Release keystore. Use the AOSP platform test key so signature-level permissions
# (BLUETOOTH_PRIVILEGED, WRITE_SECURE_SETTINGS, …) are granted; see BUILD.md
# "取 AOSP 默认 platform 密钥" for the pk8/x509.pem -> jks conversion.
# The certificate SHA256 must match the head unit's framework-res, otherwise those
# permissions are never granted even though the APK installs.
ANDROID_KEYSTORE_PATH=/absolute/path/to/platform.jks
ANDROID_KEYSTORE_PASSWORD=android
ANDROID_KEY_ALIAS=android
ANDROID_KEY_PASSWORD=android
