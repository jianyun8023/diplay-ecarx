<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="settings_voice_title">語音自檢</string>
    <string name="settings_voice_description">請先斷開 CarPlay。三種音源是擷取用途，並非三個實體麥克風。錄音 5 秒後，可將同一段音訊分別透過媒體和 Siri 助理路徑播放。未錄音時播放低音量的 1 秒提示音。音訊僅留記憶體，關閉即清除；裝置與電平資訊寫入報告。本機自檢不等同於真實 Siri 工作階段。</string>
    <string name="settings_voice_source">擷取音源</string>
    <string name="settings_voice_record">錄音 5 秒</string>
    <string name="settings_voice_media">透過媒體路徑播放</string>
    <string name="settings_voice_assistant">透過 Siri 助理路徑播放</string>
    <string name="settings_voice_clear">停止並清除</string>
    <string name="settings_voice_permission">請允許麥克風權限，再點錄音。若已永久拒絕，請在 Android 應用程式設定中開啟麥克風權限。</string>
    <string name="settings_voice_disconnect">請斷開 CarPlay 後再執行本機自檢。</string>
    <string name="settings_voice_busy">上次自檢仍在停止，請稍後重試。</string>
    <string name="settings_voice_recording">正在錄音，持續 5 秒…</string>
    <string name="settings_voice_playing">正在播放…</string>
    <string name="settings_voice_cleared">已停止，錄音已清除。</string>
</resources>
