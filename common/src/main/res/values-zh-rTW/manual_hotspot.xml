<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="settings_manual_hotspot_title">車機熱點開關（實驗性）</string>
    <string name="settings_manual_hotspot_description">與無線 CarPlay 共用熱點啟動流程。Android 9 啟動失敗時，會依目前狀態重設 Wi-Fi 後重試一次。請先中斷 CarPlay；此操作可能中斷其他 Wi-Fi 或熱點裝置，熱點名稱與密碼不變。</string>
    <string name="settings_manual_hotspot_on">開啟熱點</string>
    <string name="settings_manual_hotspot_off">關閉熱點</string>
    <string name="settings_manual_hotspot_refresh">重新整理網路狀態</string>
    <string name="settings_manual_hotspot_working">正在處理網路開關操作，請等待完成後再連線或重試。</string>
    <string name="settings_manual_hotspot_disconnect">請先結束連線過程或中斷 CarPlay，並等待熱點啟動操作結束，再變更 Wi-Fi 或熱點狀態。</string>
    <string name="settings_manual_hotspot_confirm_off">關閉熱點會中斷所有使用它的裝置，並可能中斷 CarPlay。現在關閉？</string>
    <string name="settings_manual_hotspot_state_on">熱點狀態：已開啟</string>
    <string name="settings_manual_hotspot_state_off">熱點狀態：已關閉</string>
    <string name="settings_manual_hotspot_state_starting">熱點狀態：正在開啟</string>
    <string name="settings_manual_hotspot_state_stopping">熱點狀態：正在關閉</string>
    <string name="settings_manual_hotspot_state_failed">熱點狀態：失敗</string>
    <string name="settings_manual_hotspot_state_unknown">熱點狀態：無法讀取，請在車機設定中查看。</string>
    <string name="settings_manual_hotspot_permission">系統拒絕了熱點控制請求。請檢查系統設定；應用程式不會自行授予權限。</string>
    <string name="settings_manual_hotspot_unsupported">此系統無法直接控制熱點，請使用車機熱點設定。</string>
    <string name="settings_manual_hotspot_timeout">逾時前未確認達到目標狀態。請查看車機設定；未自動重試。</string>
    <string name="settings_manual_hotspot_cancelled">已停止等待結果。已傳送的請求仍可能完成，請先重新整理狀態再重試。</string>
    <string name="settings_manual_hotspot_failed">熱點請求失敗。請查看車機設定；未自動重試。</string>
    <string name="settings_manual_hotspot_recover">恢復熱點</string>
    <string name="settings_manual_hotspot_confirm_recover">停止熱點，先檢查 Wi-Fi 狀態；已開啟時先關閉，再開啟、關閉，最後重試熱點一次。此操作會中斷 Wi-Fi 與熱點上的裝置。</string>
</resources>
