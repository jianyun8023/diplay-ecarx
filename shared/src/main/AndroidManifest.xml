<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Guards the run-time USB permission result receivers on Android 12 and older. -->
    <permission
        android:name="${applicationId}.USB_PERMISSION_RESULT"
        android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.USB_PERMISSION_RESULT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Lets DiPlay register a self-managed call with Telecom; a normal permission, no prompt. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CONNECTIVITY_INTERNAL" android:maxSdkVersion="28" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MANAGE_USB" android:maxSdkVersion="28" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- No maxSdkVersion: MIUI 13 on Android 12 still checks BLUETOOTH for RFCOMM connections (#671). -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <!--
      ECARX (亿咖通) XUI / CEVT permissions for the instrument-cluster (DIM) output.

      Provenance: a probe run on the target head unit (Geely dcy11, Android 9, AOSP test-keys)
      reported these four as GRANTED to a platform-signed app, and
      DimInteraction.setPresentationToDimSwitch() succeeded under exactly that grant set.
      com.ecarx.permission.ADAPT_API and com.ecarx.permission.CAR_CONTROL came back denied
      there and the DIM calls still worked, so they are deliberately not requested. On a
      non-ECARX head unit the names resolve to nothing and these declarations are inert.
    -->
    <uses-permission android:name="android.cevt.dimsupportservice.permission.DIM_MESSAGING" />
    <uses-permission android:name="ecarx.oem.permission.OPENAPI_NAVI_PERMISSION" />
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
    <!-- Read-only GEAR_SELECTION for PASCD; checked before advertising wheel-speed support. -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <uses-permission android:name="android.car.permission.CAR_CONTROL_AUDIO_VOLUME" />
    <!--
      Signature-level on Android 9. This build is signed with the head unit's platform key, so the
      grant lands; without it a BluetoothProfile policy write raises SecurityException, which the
      guard reports instead of changing anything.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" />
    <!-- Factory HiCar control and navigation takeover require this platform permission. -->
    <uses-permission android:name="android.permission.CHANGE_COMPONENT_ENABLED_STATE" />
    <!-- Android 9 otherwise hides the factory navigation process from restart verification. -->
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <package android:name="com.ts.car.someip.service" />
        <intent>
            <action android:name="com.android.settings.WIFI_TETHER_SETTINGS" />
        </intent>
        <!--
          ECARX head units only. Package visibility is per-package on API 30+, so without these
          entries EcarxCapabilities' package fallback would report "not installed" on a modern
          ECARX image; the Class.forName probe ahead of it is unaffected.
        -->
        <package android:name="com.ecarx.xui.service" />
        <package android:name="com.ecarx.eas.service" />
        <package android:name="com.ecarx.assistant" />
        <package android:name="com.ecarx.xiaoka" />
        <package android:name="com.ecarx.hmi" />
        <package android:name="ecarx.naviservice" />
    </queries>

    <application android:usesCleartextTraffic="true">
        <service
            android:name="com.shilapi.xcertplay.network.CarPlayVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false" />

        <!-- Only Telecom can bind it; it carries no UI or audio, see PhoneAudioRoute. -->
        <service
            android:name="com.shilapi.xcertplay.telecom.PhoneAudioConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
